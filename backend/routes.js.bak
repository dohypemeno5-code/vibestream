/**
 * Rotas da API - Melhora App Live
 */

const express = require('express');
const router = express.Router();
const bcrypt = require('bcryptjs');
const uuid = require('uuid');

module.exports = function(database, firewall) {
  const db = () => database.getInstance();

  // ============================================================
  // HEALTH CHECK
  // ============================================================
  router.get('/health', (req, res) => {
    res.json({ status: 'ok', timestamp: new Date().toISOString() });
  });

  // ============================================================
  // AUTENTICAÇÃO
  // ============================================================
  
  router.post('/auth/register', async (req, res) => {
    try {
      const { username, email, password, displayName } = req.body;
      
      if (!username || !email || !password) {
        return res.status(400).json({ error: 'Campos obrigatórios: username, email, password' });
      }

      if (username.length < 3 || username.length > 30) {
        return res.status(400).json({ error: 'Username deve ter entre 3 e 30 caracteres' });
      }
      if (password.length < 6) {
        return res.status(400).json({ error: 'Senha deve ter no mínimo 6 caracteres' });
      }

      const existing = db().get('SELECT id FROM users WHERE username = ? OR email = ?', [username, email]);
      if (existing) {
        return res.status(409).json({ error: 'Username ou email já cadastrado' });
      }

      const id = uuid.v4();
      const passwordHash = await bcrypt.hash(password, 10);
      const ip = req.ip || req.connection.remoteAddress;

      db().run(
        'INSERT INTO users (id, username, email, password_hash, display_name, ip_address, user_agent) VALUES (?, ?, ?, ?, ?, ?, ?)',
        [id, username, email, passwordHash, displayName || username, ip, req.headers['user-agent'] || '']
      );

      db().run(
        'INSERT INTO security_logs (id, action, user_id, ip_address) VALUES (?, ?, ?, ?)',
        [uuid.v4(), 'user_registered', id, ip]
      );

      res.status(201).json({ 
        message: 'Conta criada com sucesso!',
        user: { id, username, email, displayName: displayName || username }
      });
    } catch (error) {
      console.error('[AUTH] Erro no registro:', error);
      res.status(500).json({ error: 'Erro interno do servidor' });
    }
  });

  router.post('/auth/login', async (req, res) => {
    try {
      const { username, password } = req.body;
      
      if (!username || !password) {
        return res.status(400).json({ error: 'Username e password são obrigatórios' });
      }

      const user = db().get('SELECT * FROM users WHERE username = ? OR email = ?', [username, username]);
      if (!user) {
        return res.status(401).json({ error: 'Credenciais inválidas' });
      }

      const bans = db().query(
        "SELECT * FROM bans WHERE user_id = ? AND (ban_type = 'permanente' OR (ban_type = 'temporario' AND expires_at > datetime('now')))",
        [user.id]
      );
      
      if (bans.length > 0) {
        return res.status(403).json({ error: 'Conta banida', reason: bans[0].reason, expiresAt: bans[0].expires_at });
      }

      const validPassword = await bcrypt.compare(password, user.password_hash);
      if (!validPassword) {
        return res.status(401).json({ error: 'Credenciais inválidas' });
      }

      const ip = req.ip || req.connection.remoteAddress;
      
      db().run(
        "UPDATE users SET last_login = datetime('now'), ip_address = ?, user_agent = ? WHERE id = ?",
        [ip, req.headers['user-agent'] || '', user.id]
      );

      db().run(
        'INSERT INTO security_logs (id, action, user_id, ip_address) VALUES (?, ?, ?, ?)',
        [uuid.v4(), 'user_login', user.id, ip]
      );

      req.session.userId = user.id;
      req.session.role = user.role;

      res.json({
        message: 'Login realizado!',
        user: {
          id: user.id,
          username: user.username,
          displayName: user.display_name,
          avatar: user.avatar_url,
          role: user.role,
          coins: user.coins,
          diamonds: user.diamonds,
          isVerified: user.is_verified,
          isLive: user.is_live
        }
      });
    } catch (error) {
      console.error('[AUTH] Erro no login:', error);
      res.status(500).json({ error: 'Erro interno do servidor' });
    }
  });

  router.post('/auth/logout', (req, res) => {
    req.session.destroy();
    res.json({ message: 'Logout realizado' });
  });

  router.get('/auth/me', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const user = db().get(
      'SELECT id, username, email, display_name, avatar_url, bio, role, coins, diamonds, is_verified, is_live, followers_count, following_count, created_at FROM users WHERE id = ?',
      [req.session.userId]
    );

    if (!user) {
      return res.status(404).json({ error: 'Usuário não encontrado' });
    }

    res.json({ user });
  });

  // ============================================================
  // USUÁRIOS
  // ============================================================
  
  router.get('/users/:id', (req, res) => {
    const user = db().get(
      "SELECT id, username, display_name, avatar_url, bio, role, is_verified, followers_count, following_count, is_live, live_title FROM users WHERE id = ? AND status = 'active'",
      [req.params.id]
    );

    if (!user) {
      return res.status(404).json({ error: 'Usuário não encontrado' });
    }

    res.json({ user });
  });

  router.post('/users/:id/follow', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const targetId = req.params.id;
    if (req.session.userId === targetId) {
      return res.status(400).json({ error: 'Não pode seguir a si mesmo' });
    }

    try {
      const existing = db().get(
        'SELECT id FROM followers WHERE follower_id = ? AND following_id = ?',
        [req.session.userId, targetId]
      );

      if (existing) {
        db().run('DELETE FROM followers WHERE follower_id = ? AND following_id = ?', [req.session.userId, targetId]);
        db().run('UPDATE users SET followers_count = MAX(0, followers_count - 1) WHERE id = ?', [targetId]);
        db().run('UPDATE users SET following_count = MAX(0, following_count - 1) WHERE id = ?', [req.session.userId]);
        return res.json({ following: false, message: 'Deixou de seguir' });
      } else {
        db().run('INSERT INTO followers (id, follower_id, following_id) VALUES (?, ?, ?)', [uuid.v4(), req.session.userId, targetId]);
        db().run('UPDATE users SET followers_count = followers_count + 1 WHERE id = ?', [targetId]);
        db().run('UPDATE users SET following_count = following_count + 1 WHERE id = ?', [req.session.userId]);
        return res.json({ following: true, message: 'Seguindo agora' });
      }
    } catch (error) {
      console.error('[FOLLOW] Erro:', error);
      res.status(500).json({ error: 'Erro interno' });
    }
  });

  // ============================================================
  // LIVES
  // ============================================================

  router.get('/lives', (req, res) => {
    const page = parseInt(req.query.page) || 1;
    const limit = parseInt(req.query.limit) || 20;
    const offset = (page - 1) * limit;
    const category = req.query.category;

    let query = `
      SELECT l.*, u.username, u.display_name, u.avatar_url, u.is_verified
      FROM lives l
      JOIN users u ON l.user_id = u.id
      WHERE l.status = 'live'
    `;
    let params = [];

    if (category && category !== 'todos') {
      query += ' AND l.category = ?';
      params.push(category);
    }

    query += ' ORDER BY l.viewer_count DESC, l.is_featured DESC LIMIT ? OFFSET ?';
    params.push(limit, offset);

    const lives = db().query(query, params);
    const totalRow = db().get("SELECT COUNT(*) as count FROM lives WHERE status = 'live'");
    const total = totalRow ? totalRow.count : 0;

    res.json({
      lives,
      pagination: { page, limit, total, totalPages: Math.ceil(total / limit) }
    });
  });

  router.post('/lives/start', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const { title, category, tags, isPrivate } = req.body;
    if (!title) {
      return res.status(400).json({ error: 'Título é obrigatório' });
    }

    const liveId = uuid.v4();
    const streamKey = uuid.v4().replace(/-/g, '');

    db().run(
      "INSERT INTO lives (id, user_id, title, category, tags, is_private, stream_url, started_at, status) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'), 'live')",
      [liveId, req.session.userId, title, category || 'geral', JSON.stringify(tags || []), isPrivate ? 1 : 0, `/stream/${streamKey}`]
    );

    db().run('UPDATE users SET is_live = 1, live_title = ? WHERE id = ?', [title, req.session.userId]);

    db().run(
      'INSERT INTO security_logs (id, action, user_id, details) VALUES (?, ?, ?, ?)',
      [uuid.v4(), 'live_started', req.session.userId, JSON.stringify({ liveId, title })]
    );

    res.status(201).json({ liveId, streamKey, streamUrl: `/stream/${streamKey}`, message: 'Live iniciada!' });
  });

  router.post('/lives/:id/end', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const live = db().get('SELECT * FROM lives WHERE id = ? AND user_id = ?', [req.params.id, req.session.userId]);
    if (!live) {
      return res.status(404).json({ error: 'Live não encontrada' });
    }

    db().run("UPDATE lives SET status = 'ended', ended_at = datetime('now') WHERE id = ?", [req.params.id]);
    db().run("UPDATE users SET is_live = 0, live_title = '' WHERE id = ?", [req.session.userId]);

    res.json({ message: 'Live encerrada' });
  });

  router.get('/lives/:id', (req, res) => {
    const live = db().get(`
      SELECT l.*, u.username, u.display_name, u.avatar_url, u.is_verified
      FROM lives l JOIN users u ON l.user_id = u.id
      WHERE l.id = ?
    `, [req.params.id]);

    if (!live) {
      return res.status(404).json({ error: 'Live não encontrada' });
    }

    db().run('UPDATE lives SET viewer_count = viewer_count + 1 WHERE id = ?', [req.params.id]);

    const comments = db().query(`
      SELECT lc.*, u.username, u.display_name, u.avatar_url
      FROM live_comments lc JOIN users u ON lc.user_id = u.id
      WHERE lc.live_id = ?
      ORDER BY lc.created_at DESC LIMIT 50
    `, [req.params.id]);

    res.json({ live, comments });
  });

  // ============================================================
  // FAMÍLIAS
  // ============================================================

  router.get('/families', (req, res) => {
    const page = parseInt(req.query.page) || 1;
    const limit = parseInt(req.query.limit) || 20;
    const offset = (page - 1) * limit;

    const families = db().query(`
      SELECT f.*, u.username as owner_name, u.display_name as owner_display_name, u.avatar_url as owner_avatar
      FROM families f JOIN users u ON f.owner_id = u.id
      WHERE f.is_public = 1
      ORDER BY f.total_diamonds DESC, f.members_count DESC
      LIMIT ? OFFSET ?
    `, [limit, offset]);

    const totalRow = db().get('SELECT COUNT(*) as count FROM families WHERE is_public = 1');
    const total = totalRow ? totalRow.count : 0;

    res.json({ families, pagination: { page, limit, total, totalPages: Math.ceil(total / limit) } });
  });

  router.post('/families', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const { name, description, isPublic } = req.body;
    if (!name) {
      return res.status(400).json({ error: 'Nome da família é obrigatório' });
    }

    const existing = db().get('SELECT id FROM families WHERE name = ?', [name]);
    if (existing) {
      return res.status(409).json({ error: 'Já existe uma família com este nome' });
    }

    const familyId = uuid.v4();
    db().run(
      'INSERT INTO families (id, name, description, owner_id, is_public) VALUES (?, ?, ?, ?, ?)',
      [familyId, name, description || '', req.session.userId, isPublic !== false ? 1 : 0]
    );

    db().run(
      "INSERT INTO family_members (id, family_id, user_id, role) VALUES (?, ?, ?, 'owner')",
      [uuid.v4(), familyId, req.session.userId]
    );

    res.status(201).json({ familyId, name, message: 'Família criada com sucesso!' });
  });

  router.get('/families/:id', (req, res) => {
    const family = db().get(`
      SELECT f.*, u.username as owner_name, u.display_name as owner_display_name, u.avatar_url as owner_avatar
      FROM families f JOIN users u ON f.owner_id = u.id
      WHERE f.id = ?
    `, [req.params.id]);

    if (!family) {
      return res.status(404).json({ error: 'Família não encontrada' });
    }

    const members = db().query(`
      SELECT fm.role, fm.joined_at, fm.diamonds_contributed,
             u.id, u.username, u.display_name, u.avatar_url, u.is_verified, u.is_live
      FROM family_members fm JOIN users u ON fm.user_id = u.id
      WHERE fm.family_id = ?
      ORDER BY fm.role = 'owner' DESC, fm.diamonds_contributed DESC
    `, [req.params.id]);

    res.json({ family, members });
  });

  router.post('/families/:id/join', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const family = db().get('SELECT * FROM families WHERE id = ?', [req.params.id]);
    if (!family) {
      return res.status(404).json({ error: 'Família não encontrada' });
    }

    const member = db().get(
      'SELECT id FROM family_members WHERE family_id = ? AND user_id = ?',
      [req.params.id, req.session.userId]
    );
    if (member) {
      return res.status(409).json({ error: 'Você já é membro desta família' });
    }

    db().run(
      "INSERT INTO family_members (id, family_id, user_id, role) VALUES (?, ?, ?, 'member')",
      [uuid.v4(), req.params.id, req.session.userId]
    );
    db().run('UPDATE families SET members_count = members_count + 1 WHERE id = ?', [req.params.id]);

    res.json({ message: 'Você entrou na família!' });
  });

  router.post('/families/:id/leave', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const member = db().get(
      'SELECT role FROM family_members WHERE family_id = ? AND user_id = ?',
      [req.params.id, req.session.userId]
    );
    if (!member) {
      return res.status(404).json({ error: 'Você não é membro desta família' });
    }
    if (member.role === 'owner') {
      return res.status(400).json({ error: 'O dono não pode sair. Transfira a família ou exclua.' });
    }

    db().run('DELETE FROM family_members WHERE family_id = ? AND user_id = ?', [req.params.id, req.session.userId]);
    db().run('UPDATE families SET members_count = MAX(0, members_count - 1) WHERE id = ?', [req.params.id]);

    res.json({ message: 'Você saiu da família' });
  });

  // ============================================================
  // PRESENTES
  // ============================================================
  
  router.get('/gifts', (req, res) => {
    const gifts = db().query('SELECT * FROM gifts WHERE is_active = 1 ORDER BY price_coins ASC');
    res.json({ gifts });
  });

  router.post('/gifts/send', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const { liveId, receiverId, giftId, quantity, message } = req.body;
    if (!liveId || !receiverId || !giftId) {
      return res.status(400).json({ error: 'liveId, receiverId e giftId são obrigatórios' });
    }

    const gift = db().get('SELECT * FROM gifts WHERE id = ? AND is_active = 1', [giftId]);
    if (!gift) {
      return res.status(404).json({ error: 'Presente não encontrado' });
    }

    const qty = parseInt(quantity) || 1;
    const totalCoins = gift.price_coins * qty;

    const sender = db().get('SELECT coins, diamonds FROM users WHERE id = ?', [req.session.userId]);
    if (sender.coins < totalCoins) {
      return res.status(400).json({ error: 'Saldo insuficiente de moedas' });
    }

    db().run('UPDATE users SET coins = coins - ? WHERE id = ?', [totalCoins, req.session.userId]);
    const receiverDiamonds = Math.floor(totalCoins * 0.7);
    db().run('UPDATE users SET diamonds = diamonds + ? WHERE id = ?', [receiverDiamonds, receiverId]);

    db().run(
      'INSERT INTO gift_transactions (id, live_id, sender_id, receiver_id, gift_id, quantity, total_coins, message) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
      [uuid.v4(), liveId, req.session.userId, receiverId, giftId, qty, totalCoins, message || '']
    );

    res.json({ message: 'Presente enviado!', coinsSpent: totalCoins, diamondsEarned: receiverDiamonds });
  });

  // ============================================================
  // TICKETS
  // ============================================================

  router.post('/tickets', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const { ticketType, subject, description, evidenceUrl, reportedUserId, reportedLiveId } = req.body;
    if (!subject || !description) {
      return res.status(400).json({ error: 'Assunto e descrição são obrigatórios' });
    }

    const ticketId = uuid.v4();
    db().run(
      'INSERT INTO tickets (id, user_id, ticket_type, subject, description, evidence_url, reported_user_id, reported_live_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)',
      [ticketId, req.session.userId, ticketType || 'denuncia', subject, description, evidenceUrl || '', reportedUserId || null, reportedLiveId || null]
    );

    res.status(201).json({ ticketId, message: 'Ticket criado com sucesso! Você receberá uma resposta em breve.' });
  });

  router.get('/tickets', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const tickets = db().query('SELECT * FROM tickets WHERE user_id = ? ORDER BY created_at DESC', [req.session.userId]);
    res.json({ tickets });
  });

  router.get('/tickets/:id', (req, res) => {
    if (!req.session.userId) {
      return res.status(401).json({ error: 'Não autenticado' });
    }

    const ticket = db().get('SELECT * FROM tickets WHERE id = ? AND user_id = ?', [req.params.id, req.session.userId]);
    if (!ticket) {
      return res.status(404).json({ error: 'Ticket não encontrado' });
    }

    res.json({ ticket });
  });

  // ============================================================
  // RANKING
  // ============================================================
  
  router.get('/ranking', (req, res) => {
    const type = req.query.type || 'diamonds';
    const limit = parseInt(req.query.limit) || 20;

    let ranking = [];
    if (type === 'diamonds') {
      ranking = db().query(
        "SELECT id, username, display_name, avatar_url, diamonds, followers_count, is_verified, is_live FROM users WHERE status = 'active' ORDER BY diamonds DESC LIMIT ?",
        [limit]
      );
    } else if (type === 'followers') {
      ranking = db().query(
        "SELECT id, username, display_name, avatar_url, followers_count, diamonds, is_verified, is_live FROM users WHERE status = 'active' ORDER BY followers_count DESC LIMIT ?",
        [limit]
      );
    } else if (type === 'families') {
      ranking = db().query(`
        SELECT f.*, u.username as owner_name FROM families f JOIN users u ON f.owner_id = u.id
        ORDER BY f.total_diamonds DESC LIMIT ?
      `, [limit]);
    }

    res.json({ ranking, type });
  });

  // ============================================================
  // CATEGORIAS
  // ============================================================
  router.get('/categories', (req, res) => {
    const categories = [
      { id: 'todos', name: 'Todos', icon: '🔥' },
      { id: 'geral', name: 'Geral', icon: '📺' },
      { id: 'games', name: 'Games', icon: '🎮' },
      { id: 'musica', name: 'Música', icon: '🎵' },
      { id: 'danca', name: 'Dança', icon: '💃' },
      { id: 'esportes', name: 'Esportes', icon: '⚽' },
      { id: 'comedia', name: 'Comédia', icon: '😂' },
      { id: 'educacao', name: 'Educação', icon: '📚' },
      { id: 'entrevista', name: 'Entrevista', icon: '🎙️' },
      { id: 'culinaria', name: 'Culinária', icon: '🍳' },
      { id: 'arte', name: 'Arte & Criatividade', icon: '🎨' },
      { id: 'outdoor', name: 'Ao Ar Livre', icon: '🌄' },
      { id: 'noticias', name: 'Notícias', icon: '📰' },
    ];
    res.json({ categories });
  });

  // ============================================================
  // REGRAS
  // ============================================================
  router.get('/rules', (req, res) => {
    const rules = {
      gerais: [
        'Respeite todos os membros da plataforma',
        'Não é permitido conteúdo ofensivo, discriminatório ou ilegal',
        'Proibido compartilhar informações pessoais de outros usuários',
        'Não faça spam ou divulgue links maliciosos',
        'Mantenha um ambiente seguro e amigável para todos'
      ],
      lives: [
        'Não transmita conteúdo protegido por direitos autorais',
        'Proibido mostrar conteúdo adulto ou violento',
        'Não incentive comportamento perigoso ou ilegal',
        'Respeite os moderadores e administradores',
        'Não use bots ou ferramentas automatizadas para manipular viewers'
      ],
      denuncias: [
        'Denúncias são analisadas em até 24 horas',
        'Forneça evidências claras ao fazer uma denúncia',
        'Denúncias falsas resultam em punição ao denunciante',
        'Seja específico ao descrever o motivo da denúncia',
        'Acompanhe o status do seu ticket na seção "Meus Tickets"'
      ],
      penalidades: [
        '1ª infração: Aviso',
        '2ª infração: Suspensão de 7 dias',
        '3ª infração: Banimento permanente',
        'Infrações graves resultam em banimento imediato',
        'O uso de múltiplas contas para evitar banimento resulta em banimento de todas as contas'
      ]
    };
    res.json({ rules });
  });

  return router;
};
